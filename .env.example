# Copia este archivo a `.env` y completa los valores.
# Nunca commits `.env`. Tras cambiar variables: npx expo start -c

# --- App ---
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=https://api.careme360.com

# --- Sentry (DSN del proyecto; en EAS usa Environment Variables / Secrets) ---
EXPO_PUBLIC_SENTRY_DSN=

# --- N8N (webhook de analisis facial; preferible proxy autenticado en backend) ---
EXPO_PUBLIC_N8N_URL=
