{
  "expo": {
    "name": "careme360",
    "slug": "careme360",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon-careme.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "careme",
    "splash": {
      "image": "./assets/images/icon-careme.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-careme.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.imtegrim.uni2",
      "runtimeVersion": "1.0.0",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/images/icon-careme.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      "@react-native-community/datetimepicker",
      "react-native-vision-camera",
      "expo-build-properties"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4a5b62b6-5a9b-4439-83ff-90d63f30df9a"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/4a5b62b6-5a9b-4439-83ff-90d63f30df9a"
    }
  },
  "react-native-toast-message": {
    "position": "top",
    "visibilityTime": 4000,
    "autoHide": true,
    "topOffset": 30,
    "bottomOffset": 40,
    "style": {
      "borderRadius": 10,
      "padding": 10
    },
    "text1Style": {
      "fontSize": 16,
      "fontWeight": "bold"
    },
    "text2Style": {
      "fontSize": 14
    }
  }
}
