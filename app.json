{
  "expo": {
    "name": "careme360",
    "slug": "careme360",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon-careme.png",
    "userInterfaceStyle": "dark",
    "scheme": "careme",
    "splash": {
      "image": "./assets/images/icon-careme.png",
      "resizeMode": "contain",
      "backgroundColor": "#302D34"
    },
    "ios": {
      "bundleIdentifier": "com.imtegrim.uni2",
      "supportsTablet": true,
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Careme360 necesita acceso a la cámara para realizar diagnósticos faciales.",
        "NSMicrophoneUsageDescription": "Careme360 necesita acceso al micrófono para grabar video.",
        "NSPhotoLibraryUsageDescription": "Careme360 necesita acceso a tus fotos para guardar imágenes de diagnóstico.",
        "NSPhotoLibraryAddUsageDescription": "Careme360 necesita permiso para guardar fotos en tu galería.",
        "NSLocationWhenInUseUsageDescription": "Esta app necesita acceder a tu ubicación mientras la usas para mostrarte los servicios disponibles más cercanos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-careme.png",
        "backgroundColor": "#302D34"
      },
      "package": "com.imtegrim.uni2",
      "runtimeVersion": "1.0.0",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/images/icon-careme.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Careme360 necesita acceso a la cámara para realizar diagnósticos faciales.",
          "microphonePermission": "Careme360 necesita acceso al micrófono para grabar video.",
          "recordAudioAndroid": true
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Careme360 necesita acceso a la cámara para realizar diagnósticos faciales.",
          "enableMicrophonePermission": true,
          "microphonePermissionText": "Careme360 necesita acceso al micrófono para grabar video.",
          "enableFrameProcessors": true
        }
      ],
      "expo-image",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "uni2",
          "organization": "andres-oz"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4a5b62b6-5a9b-4439-83ff-90d63f30df9a"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/4a5b62b6-5a9b-4439-83ff-90d63f30df9a"
    }
  },
  "react-native-toast-message": {
    "position": "top",
    "visibilityTime": 4000,
    "autoHide": true,
    "topOffset": 30,
    "bottomOffset": 40,
    "style": {
      "borderRadius": 10,
      "padding": 10
    },
    "text1Style": {
      "fontSize": 16,
      "fontWeight": "bold"
    },
    "text2Style": {
      "fontSize": 14
    }
  }
}
